# Postgres 連線字串。本機開發可以用 `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16`
# 起一個本機 Postgres，或直接用 Neon / Vercel Postgres 給的免費資料庫。
# 部署到 Vercel 時，用 Storage 分頁加一個 Postgres（Neon）：
#   DATABASE_URL = 它給的 pooled 連線字串（通常叫 POSTGRES_PRISMA_URL）
#   DIRECT_URL   = 它給的 non-pooling 直連字串（通常叫 POSTGRES_URL_NON_POOLING），跑 migration 用
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trip_planner"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/trip_planner"

# 用來簽章登入 cookie，正式環境請換成一組隨機字串。
AUTH_SECRET="dev-only-secret-change-me-in-production"

# 選填：設定後，「導入長文」會改用 AI（Claude）解析，解析失敗會自動退回規則式解析。
# 不設定就只用規則式解析，不需要任何 API Key 也能正常運作。
# ANTHROPIC_API_KEY=""
